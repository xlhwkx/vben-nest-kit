{
  "name": "qingzhan-monorepo",
  "version": "0.2.0",
  "private": true,
  "keywords": [
    "qingzhan",
    "vben",
    "nestjs",
    "vue",
    "admin",
    "starter",
    "monorepo"
  ],
  "homepage": "https://github.com/xlhwkx/vben-nest-kit",
  "bugs": "https://github.com/xlhwkx/vben-nest-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xlhwkx/vben-nest-kit.git"
  },
  "license": "MIT",
  "author": "xlhwkx",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build:analyze": "pnpm --filter @qingzhan/admin build:analyze",
    "build:docker": "docker build -f scripts/deploy/Dockerfile -t qingzhan-admin:local .",
    "build:admin": "pnpm --filter @qingzhan/admin build",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "check:delivery:artifacts": "node scripts/qingzhan/check-delivery-artifacts.mjs",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev:admin": "pnpm --filter @qingzhan/admin dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "node ./scripts/postinstall-stub.mjs",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install",
    "publint": "vsh publint",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test:benchmark": "vitest bench --run",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "catalog": "pnpm dlx codemod pnpm/catalog",
    "test:load:smoke": "node scripts/qingzhan/load-smoke.mjs",
    "test:auth:browser": "node scripts/qingzhan/browser-auth-regression.mjs",
    "test:delivery": "vitest run packages/effects/request/src packages/utils/src packages/stores/src/modules/dict.test.ts internal/vite-config/src apps/admin/__tests__/unit apps/admin/src/adapter/component/__tests__",
    "test:delivery:browser": "node scripts/qingzhan/run-browser-regression.mjs",
    "docs:dev": "pnpm -F @qingzhan/docs-site run dev",
    "docs:build": "pnpm -F @qingzhan/docs-site run build",
    "docs:preview": "pnpm -F @qingzhan/docs-site run preview",
    "dev": "pnpm dev:admin",
    "dev:server": "pnpm --filter @qingzhan/server start:dev",
    "build": "pnpm build:admin && pnpm build:server",
    "build:server": "pnpm --filter @qingzhan/server build",
    "preview": "pnpm --filter @qingzhan/admin preview",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" --no-progress",
    "check:delivery:types": "pnpm --filter @qingzhan/admin typecheck && tsc --noEmit --incremental false -p packages/effects/request/tsconfig.json && tsc --noEmit --incremental false -p packages/utils/tsconfig.json && tsc --noEmit --incremental false -p internal/vite-config/tsconfig.json && pnpm --filter @qingzhan/server exec tsc --noEmit --incremental false && pnpm --filter @qingzhan/server exec tsc --noEmit --incremental false -p test/tsconfig.json && pnpm --filter @qingzhan/server exec tsc -p prisma/tsconfig.json",
    "check:delivery:lint": "oxlint internal/vite-config/src apps/admin/src scripts/qingzhan/*.mjs",
    "check:starter": "node scripts/qingzhan/check-starter.mjs",
    "build:docker:server": "docker build -f apps/server/Dockerfile -t qingzhan-server:local ."
  },
  "dependencies": {
    "sortablejs": "catalog:"
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
