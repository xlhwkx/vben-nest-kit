VITE_APP_TITLE=青栈管理后台
VITE_APP_NAMESPACE=qingzhan-admin-v1
VITE_BASE=/

# 同源部署：反向代理 /api 到 Nest；跨域部署可用环境变量或 .env.production.local 覆盖。
VITE_GLOB_API_URL=/api
VITE_NITRO_MOCK=false

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
