generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// Optimistic management edit revision; independent of authentication tokenVersion.
  version      Int            @default(1)
  id           String         @id @default(uuid(7)) @db.Uuid
  username     String         @unique @db.VarChar(64)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  realName     String         @map("real_name") @db.VarChar(128)
  homePath     String?        @map("home_path") @db.VarChar(255)
  avatar       String?        @db.VarChar(512)
  /// 0=女 1=男 2=未知（合同 user_gender）
  gender       Int            @default(2)
  deptId       String?        @map("dept_id") @db.Uuid
  remark       String?        @db.VarChar(512)
  status       Int            @default(1) // 1=enabled 0=disabled
  tokenVersion Int            @default(0) @map("token_version")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)
  dept         Dept?          @relation(fields: [deptId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  refreshTokens RefreshToken[]

  @@index([status])
  @@index([deptId])
  @@map("users")
}

model Role {
  /// Optimistic management edit revision; independent of authentication tokenVersion.
  version      Int            @default(1)
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(128)
  status      Int              @default(1)
  remark      String?          @db.VarChar(512)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid(7)) @db.Uuid
  code      String           @unique @db.VarChar(128)
  name      String?          @db.VarChar(128)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles     RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  jti       String    @unique @db.VarChar(64)
  familyId  String    @default(uuid()) @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(128)
  tokenVersion Int    @default(0) @map("token_version")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Menu {
  /// Optimistic management edit revision; independent of authentication tokenVersion.
  version      Int            @default(1)
  id        String    @id @default(uuid(7)) @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @unique @db.VarChar(128)
  path      String    @db.VarChar(255)
  component String?   @db.VarChar(255)
  redirect  String?   @db.VarChar(255)
  /// catalog | menu | button | embedded | link
  type      String    @db.VarChar(32)
  status    Int       @default(1)
  authCode  String?   @map("auth_code") @db.VarChar(128)
  /// Vben route meta (title/icon/order/affixTab/keepAlive/authority/...)
  meta      Json      @default("{}")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  parent    Menu?     @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Menu[]    @relation("MenuTree")
  roles     RoleMenu[]

  @@index([parentId])
  @@index([status])
  @@map("menus")
}

model RoleMenu {
  roleId String @map("role_id") @db.Uuid
  menuId String @map("menu_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}

model Dept {
  id        String    @id @default(uuid(7)) @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @db.VarChar(128)
  status    Int       @default(1)
  remark    String?   @db.VarChar(512)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  parent    Dept?     @relation("DeptTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Dept[]    @relation("DeptTree")
  users     User[]

  @@index([parentId])
  @@index([status])
  @@map("depts")
}


model DictType {
  id        String     @id @default(uuid(7)) @db.Uuid
  name      String     @db.VarChar(128)
  code      String     @unique @db.VarChar(64)
  status    Int        @default(1)
  remark    String?    @db.VarChar(512)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  items     DictItem[]

  @@index([status])
  @@map("dict_types")
}

model DictItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  dictCode  String   @map("dict_code") @db.VarChar(64)
  label     String   @db.VarChar(128)
  /// number | string（合同/mock 均可）
  value     Json
  sort      Int      @default(0)
  status    Int      @default(1)
  color     String?  @db.VarChar(64)
  remark    String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  type      DictType @relation(fields: [dictCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@index([dictCode])
  @@index([status])
  @@map("dict_items")
}

/// One durable invalidation revision, updated by dictionary table triggers.
model DictionaryRevision {
  id      Int    @id @default(1)
  version BigInt @default(1)

  @@map("dictionary_revision")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  username  String?  @db.VarChar(64)
  action    String   @db.VarChar(128)
  module    String?  @db.VarChar(64)
  method    String?  @db.VarChar(16)
  path      String?  @db.VarChar(512)
  ip        String?  @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  requestId String?  @map("request_id") @db.VarChar(128)
  status    Int?
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
