generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid(7)) @db.Uuid
  username     String         @unique @db.VarChar(64)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  realName     String         @map("real_name") @db.VarChar(128)
  homePath     String?        @map("home_path") @db.VarChar(255)
  avatar       String?        @db.VarChar(512)
  status       Int            @default(1) // 1=enabled 0=disabled
  tokenVersion Int            @default(0) @map("token_version")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)
  roles        UserRole[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(128)
  status      Int              @default(1)
  remark      String?          @db.VarChar(512)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       UserRole[]
  permissions RolePermission[]
  menus       RoleMenu[]

  @@map("roles")
}

model Permission {
  id        String           @id @default(uuid(7)) @db.Uuid
  code      String           @unique @db.VarChar(128)
  name      String?          @db.VarChar(128)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles     RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  jti       String    @unique @db.VarChar(64)
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Menu {
  id        String    @id @default(uuid(7)) @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  name      String    @unique @db.VarChar(128)
  path      String    @db.VarChar(255)
  component String?   @db.VarChar(255)
  redirect  String?   @db.VarChar(255)
  /// catalog | menu | button | embedded | link
  type      String    @db.VarChar(32)
  status    Int       @default(1)
  authCode  String?   @map("auth_code") @db.VarChar(128)
  /// Vben route meta (title/icon/order/affixTab/keepAlive/authority/...)
  meta      Json      @default("{}")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  parent    Menu?     @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Menu[]    @relation("MenuTree")
  roles     RoleMenu[]

  @@index([parentId])
  @@index([status])
  @@map("menus")
}

model RoleMenu {
  roleId String @map("role_id") @db.Uuid
  menuId String @map("menu_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_menus")
}
