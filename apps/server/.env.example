# 复制为 .env 后按需修改；切勿提交 .env
# Boolean flags accept true/false/1/0 (case-insensitive); other values fail startup.
# --- Nest (apps/server) ---
APP_PORT=5320
NODE_ENV=development
# Explicit opt-in for development demo accounts. Never enable on production DBs.
# ALLOW_DEMO_SEED=true
# Empty disables X-Forwarded-For trust. Set only trusted ingress IPs/CIDRs.
TRUST_PROXY=
SHUTDOWN_TIMEOUT_MS=25000
# Production Compose publishes API to loopback by default.
APP_BIND_HOST=127.0.0.1

# --- Postgres（宿主端口避开本机已占用的 5432）---
POSTGRES_USER=qingzhan
POSTGRES_PASSWORD=qingzhan
POSTGRES_DB=qingzhan
POSTGRES_PORT=55433
DATABASE_URL=postgresql://qingzhan:qingzhan@localhost:55433/qingzhan?schema=public

# --- Redis（技术方案 §19.4：Compose 默认设密码；宿主端口避开 6379）---
REDIS_PORT=56379
REDIS_PASSWORD=qingzhan
# 带密 URL；db 0=缓存（队列可用 1 或 key 前缀分离）
REDIS_URL=redis://:qingzhan@localhost:56379/0

# --- JWT（请换成足够长的随机串）---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-qingzhan
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-qingzhan
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# --- Cookie / CORS（本地 HTTP 放宽 secure；生产 Must secure=true + sameSite=none|lax）---
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5555,http://localhost:5666,http://localhost:5173,http://127.0.0.1:5173
# 登录/刷新/退出只接受白名单源；CORS 条目禁止通配符/路径。
# APP_PUBLIC_URL 的源也被允许；反代部署须填写实际 API 公网 URL。
APP_PUBLIC_URL=http://localhost:5320
# --- Swagger（非 production 默认开；production 默认关）---
# SWAGGER_ENABLED=true   # 生产强制开启文档
# SWAGGER_ENABLED=false  # 本地/预发强制关闭

# --- 限流 @nestjs/throttler（技术方案 §9；登录更严）---
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
# THROTTLE_LOGIN_TTL_MS=60000
# THROTTLE_LOGIN_LIMIT=10
# THROTTLE_STORAGE=redis   # redis（默认，多实例）| memory（单机急救；生产建议 redis）
# 登录 throttler：Redis 故障 → fail-closed（HTTP 503 Rate limit unavailable）
# 其它路由 throttler：Redis 故障 → fail-open + warn 日志
# THROTTLE_STORAGE=memory 时：无 login throttler 的 Redis fail-closed；
#   但 auth:fail 锁定仍读写 Redis，Redis 不可用 → 登录 fail-closed（HTTP 503）。
#   e2e 常用 memory + 抬高 limit。

# --- 登录失败锁定 auth:fail（技术方案 § Redis key 表；与 IP QPS 限流互补）---
# AUTH_FAIL_MAX=5              # 用户名与 IP 默认阈值
# AUTH_FAIL_WINDOW_SEC=900     # 窗口 15 分钟
# AUTH_FAIL_USER_MAX=5         # 可选：仅覆盖用户名阈值
# AUTH_FAIL_IP_MAX=5           # 可选：仅覆盖 IP 阈值
# 限流窗口/阈值、失败计数窗口/阈值均须为正整数；0 不表示关闭。
# 失败计数与 TTL 原子写入；读取时修复历史无过期键，正常读取不延长窗口。
# 达阈值 → HTTP 429 信封（密码正确也拒绝）；成功登录清零该用户名计数
# Redis 不可用 → fail-closed（HTTP 503 Login lock unavailable）；与 login throttler 一致

# --- 上传 ---
# UPLOAD_MAX_BYTES=5242880     # 默认 5 MiB；MulterModule.registerAsync + 业务层均读 Config
# UPLOAD_MAX_CONCURRENT=4    # 每进程同时处理上传数；含解析和存储；超出 503，无排队
# Multipart 只接受一个名为 file 的文件；额外普通字段/文件返回 400。
# UPLOAD_ALLOWED_MIME=         # 逗号分隔；默认不含 image/svg+xml
# UPLOAD_DIR=
# UPLOAD_PUBLIC_PATH=/uploads

# --- 尽力审计与 PostgreSQL 预算（事务内审计不经过此队列）---
# AUDIT_BACKGROUND_MAX_PENDING=256    # 含活动写入；满额丢弃新尽力审计并增加指标
# AUDIT_BACKGROUND_CONCURRENCY=4      # 不得大于 MAX_PENDING
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=3000    # 连接/池等待上限
# DATABASE_STATEMENT_TIMEOUT_MS=15000 # PostgreSQL 服务端单语句超时
# S3_UPLOAD_TIMEOUT_MS=15000          # S3 整次 PUT（含重试）取消预算

# --- 文件存储策略（技术方案 §10；默认 local，行为与现网一致）---
# STORAGE_DRIVER=local          # local | s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true      # MinIO / 多数兼容实现建议 true
# S3_PUBLIC_URL=                # 可选：返回给前端的对象公网前缀（无尾斜杠）
#                               # 省略时按 endpoint/bucket 或 AWS 默认拼接；
#                               # 浏览器能否打开该 URL 仍取决于桶策略 / CDN / 预签名，
#                               # 仅有拼接 URL 不等于对象已公开可读

# --- BullMQ 可选骨架（技术方案 §19 / §27；默认关，应用仍可启动）---
# QUEUE_ENABLED=false
# QUEUE_WORKER_ENABLED=false    # true 时本进程跑 mail / audit-archive stub worker
# QUEUE_REDIS_DB=1              # 可选：与缓存 DB 分离；省略则复用 REDIS_URL
# QUEUE_PREFIX=qingzhan

# --- SliderCaptcha / login captcha harness ---
# CAPTCHA_REQUIRED=false         # true → login Must carry captchaId+captchaToken from GET /api/auth/captcha
# Tickets are consumed atomically; this public ticket is NOT server-side human verification.
# CAPTCHA_E2E_BYPASS=false       # true/1 → skip captcha checks (tests/headless ONLY; never production)
# Frontend: VITE_CAPTCHA_REQUIRED=true pulls a ticket; Qingzhan Vite configs reject frontend E2E bypass.

# --- Mail (tech plan §26；默认 console，不连外网) ---
# MAIL_DRIVER=console            # console | smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=                     # never commit real secrets
# SMTP_FROM=noreply@example.com
# smtp 驱动当前为 dry-run 骨架：即使配齐也不打开 SMTP 套接字；缺 HOST/FROM 时 send 为 no-op

# --- Observability（企业稳态；默认不强制外网）---
# OTEL_ENABLED=false
# OTEL_TRACES_EXPORTER=none     # none | console | otlp（otlp 需按 docs/qingzhan/observability.md 挂 SDK）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=qingzhan-server
# METRICS_ENABLED=true          # GET /api/health/metrics；false → 404
# METRICS_TOKEN=                # 生产：指标开启时 **必填**（否则启动失败）；设置后须 Authorization: Bearer <token>
#                               # 开发可留空；生产二选一：强口令 METRICS_TOKEN，或 METRICS_ENABLED=false
#                               # 见 docs/qingzhan/observability.md / deploy.md
