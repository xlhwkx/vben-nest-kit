# Public defaults live in tracked mode files; local .env is optional.
VITE_APP_TITLE=青栈管理后台
VITE_APP_NAMESPACE=qingzhan-admin-v1

# 端口号
VITE_PORT=5555

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 配套 Nest 管理前端默认连接真实后端
VITE_NITRO_MOCK=false
VITE_CAPTCHA_REQUIRED=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
