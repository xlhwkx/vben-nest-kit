# 复制为 .env 后按需修改；切勿提交 .env
# --- Nest (apps/server) ---
APP_PORT=5320
NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=qingzhan
POSTGRES_PASSWORD=qingzhan
POSTGRES_DB=qingzhan
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qingzhan:qingzhan@localhost:5432/qingzhan?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT（下一刀 Auth 使用；请换成足够长的随机串）---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
