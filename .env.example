# 复制为 .env 后按需修改；切勿提交 .env
# --- Nest (apps/server) ---
APP_PORT=5320
NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=qingzhan
POSTGRES_PASSWORD=qingzhan
POSTGRES_DB=qingzhan
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qingzhan:qingzhan@localhost:5432/qingzhan?schema=public

# --- Redis（技术方案 §19.4：Compose 默认设密码）---
REDIS_PORT=6379
REDIS_PASSWORD=qingzhan
# 带密 URL；db 0=缓存（队列可用 1 或 key 前缀分离）
REDIS_URL=redis://:qingzhan@localhost:6379/0

# --- JWT（下一刀 Auth 使用；请换成足够长的随机串）---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
