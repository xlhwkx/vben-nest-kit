# 复制为 .env 后按需修改；切勿提交 .env
# Boolean flags accept true/false/1/0 (case-insensitive); other values fail startup.
# --- Nest (apps/server) ---
APP_PORT=5320
NODE_ENV=development
# Explicit opt-in for development demo accounts. Never enable on production DBs.
# ALLOW_DEMO_SEED=true
# Empty disables X-Forwarded-For trust. Set only trusted ingress IPs/CIDRs.
TRUST_PROXY=
SHUTDOWN_TIMEOUT_MS=25000
# Production Compose publishes API to loopback by default.
APP_BIND_HOST=127.0.0.1

# --- Postgres（宿主端口避开本机已占用的 5432）---
POSTGRES_USER=qingzhan
POSTGRES_PASSWORD=qingzhan
POSTGRES_DB=qingzhan
POSTGRES_PORT=55433
DATABASE_URL=postgresql://qingzhan:qingzhan@localhost:55433/qingzhan?schema=public

# --- Redis（技术方案 §19.4：Compose 默认设密码；宿主端口避开 6379）---
REDIS_PORT=56379
REDIS_PASSWORD=qingzhan
# 带密 URL；db 0=缓存（队列可用 1 或 key 前缀分离）
REDIS_URL=redis://:qingzhan@localhost:56379/0

# --- JWT（请换成足够长的随机串）---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-qingzhan
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-qingzhan
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# --- Cookie / CORS（本地 HTTP 放宽 secure；生产 Must secure=true + sameSite=none|lax）---
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555
# 登录/刷新/退出校验 Origin：仅允许 CORS_ORIGINS 和 APP_PUBLIC_URL 的源。
# 仅填写完整 http(s)://host[:port]，禁止通配符/路径；生产填写实际前端地址。

# --- Upload (local disk; ignore uploads/ in git) ---
APP_PUBLIC_URL=http://localhost:5320
# UPLOAD_DIR=  # default: <cwd>/uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_BYTES=5242880
# Multipart accepts one file only; no ordinary fields. Per-process buffering + storage slots:
UPLOAD_MAX_CONCURRENT=4
# UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/gif,image/webp,application/pdf  # SVG not default; add image/svg+xml only if needed
# --- Swagger（非 production 默认开；production 默认关）---
# SWAGGER_ENABLED=true   # 生产强制开启文档
# SWAGGER_ENABLED=false  # 本地/预发强制关闭

# --- 限流 @nestjs/throttler（详见 apps/server/.env.example）---
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
# THROTTLE_LOGIN_TTL_MS=60000
# THROTTLE_LOGIN_LIMIT=10
# THROTTLE_STORAGE=redis   # redis（默认）| memory（单机急救 / e2e）
# memory：仅限流存储切为内存；auth:fail 仍依赖 Redis（不可用则登录 503）。生产用 redis。
# 详见 apps/server/.env.example
# AUTH_FAIL_MAX=5
# AUTH_FAIL_WINDOW_SEC=900
# AUTH_FAIL_USER_MAX=5
# AUTH_FAIL_IP_MAX=5
# 限流窗口/阈值、失败计数窗口/阈值均须为正整数；0 不表示关闭。
# CAPTCHA_REQUIRED=false       # 仅一次性票据，非服务端人机验证
# CAPTCHA_E2E_BYPASS=false     # production 禁止 true/1

# --- Bounded best-effort audit / PostgreSQL ---
# Pending includes active writes; excess records are dropped and counted in metrics.
AUDIT_BACKGROUND_MAX_PENDING=256
AUDIT_BACKGROUND_CONCURRENCY=4
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# S3 settings and credentials: see apps/server/.env.example; Compose now forwards them.
# S3_UPLOAD_TIMEOUT_MS=15000

# --- Observability / metrics（生产见 docs/qingzhan/deploy.md）---
# METRICS_ENABLED=true
# METRICS_TOKEN=                # 生产指标开启时必填，否则进程 fail-fast
